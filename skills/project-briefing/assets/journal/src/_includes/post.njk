---
layout: base.njk
---
<article>
  <header class="article-header">
    <div class="post-meta"><time datetime="{{ date | isoDate }}">{{ date | dateLabel }}</time><span>{{ content | readingTime }} min read</span></div>
    <h1>{{ title }}</h1>
    <p class="article-dek">{{ description }}</p>
  </header>
  {% if cover %}<figure class="article-cover">
    <img src="{{ cover }}" alt="{{ coverAlt }}" width="1536" height="1024" fetchpriority="high">
    {% if coverCaption %}<figcaption>{{ coverCaption }}</figcaption>{% endif %}
  </figure>{% endif %}
  <div class="article-prose">{{ content | safe }}</div>
</article>
