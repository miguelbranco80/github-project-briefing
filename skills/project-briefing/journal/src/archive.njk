---
layout: base.njk
title: The archive
description: Every OCE fieldnote, kept at its original observation date.
permalink: /archive/index.html
---
<header class="listing-header"><div class="eyebrow">Archive</div><h1>The archive<span class="accent">.</span></h1><p>All entries, ordered by observation date.</p></header>
{% for month in collections.posts | byMonth %}
<div class="archive-heading"><h2>{{ month.label }}</h2><span>{{ month.posts | length }} entries</span></div>
{% for post in month.posts %}
<article class="archive-entry">
  <div class="archive-date"><span>No. {{ post.data.issue }}</span><time datetime="{{ post.date | isoDate }}">{{ post.date | dateLabel }}</time></div>
  <div><h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2><p>{{ post.data.description }}</p><div class="topic-list">{% for topic in post.data.topics %}<span>{{ topic.label }}</span>{% endfor %}</div></div>
  <a href="{{ post.url }}" class="archive-image" tabindex="-1" aria-hidden="true"><img src="{{ post.data.cover }}" alt="" width="1536" height="1024" loading="lazy"></a>
</article>
{% endfor %}
{% endfor %}
