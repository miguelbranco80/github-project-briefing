<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="description" content="{{ description or site.description }}">
  <title>{{ title }} · {{ site.name }}</title>
  <link rel="stylesheet" href="/assets/style.css">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="page-shell">
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="{{ site.name }} home">{{ site.name }}</a>
      <nav aria-label="Main navigation">
        <a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Blog</a>
        <a class="source-link" href="{{ site.repository }}" target="_blank" rel="noopener noreferrer">Repository ↗</a>
      </nav>
    </header>
    <main id="main">{{ content | safe }}</main>
    <footer class="site-footer">
      <a class="footer-wordmark" href="/">{{ site.name }}</a>
    </footer>
  </div>
</body>
</html>
