---
layout: base.njk
title: Blog
---
{% set latest = collections.posts | last %}
{% if latest %}
<section class="featured-story{% if not latest.data.cover %} text-only{% endif %}" aria-labelledby="latest-title">
  <div class="featured-copy">
    <div class="section-kicker"><span>Latest post</span></div>
    <div class="post-meta"><time datetime="{{ latest.date | isoDate }}">{{ latest.date | dateLabel }}</time><span>{{ latest.templateContent | readingTime }} min read</span></div>
    <h1 id="latest-title"><a href="{{ latest.url }}">{{ latest.data.title }}</a></h1>
    <p>{{ latest.data.description }}</p>
    <a class="read-link" href="{{ latest.url }}">Read article <span aria-hidden="true">↗</span></a>
  </div>
  {% if latest.data.cover %}<a class="featured-image" href="{{ latest.url }}" tabindex="-1" aria-hidden="true"><img src="{{ latest.data.cover }}" alt="" width="1536" height="1024" fetchpriority="high"></a>{% endif %}
</section>
{% if collections.posts | length > 1 %}
<section class="recent-section" aria-labelledby="earlier-title">
  <div class="section-heading"><h2 id="earlier-title">Earlier posts</h2></div>
  {% for post in collections.posts | olderPosts %}
  <article class="earlier-story{% if not post.data.cover %} text-only{% endif %}">
    {% if post.data.cover %}<a class="earlier-image" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.data.cover }}" alt="" width="1536" height="1024" loading="lazy"></a>{% endif %}
    <div><div class="post-meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | dateLabel }}</time></div><h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3><p>{{ post.data.description }}</p><a class="read-link" href="{{ post.url }}">Read article <span aria-hidden="true">↗</span></a></div>
  </article>
  {% endfor %}
</section>
{% endif %}
{% else %}
<p>No articles yet.</p>
{% endif %}
